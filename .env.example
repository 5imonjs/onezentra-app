APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# CORS: origin tambahan (mis. WebView mobile) dipisah koma, mis:
# FRONTEND_URL=http://localhost:3000,http://localhost:8081
# Batas baris per export Excel (PhpSpreadsheet menahan worksheet di memori):
# EXPORT_MAX_ROWS=50000

# ============ PRODUKSI (wajib) ============
# Salin nilai berikut ke .env server produksi (JANGAN commit .env berisi secret):
# APP_ENV=production
# APP_DEBUG=false            <- matikan trace error ke klien (lihat bootstrap/app.php:
#                               saat production, error 5xx API digenerikkan jadi "Server error.")
# APP_URL=https://api.example.com
# FRONTEND_URL=https://app.example.com   <- SATU origin https (tanpa trailing slash;
#   origin tambahan dipisah koma, mis. https://app.example.com,https://m.example.com)
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true <- wajib bila HTTPS (kalau false, cookie sesi bisa bocor via HTTP)
# SESSION_SAME_SITE=strict   <- 'lax' bila frontend & API beda site tapi butuh navigasi top-level
# SANCTUM_STATEFUL_DOMAINS=app.example.com  <- domain frontend TANPA skema/port,
#   harus cocok dengan Referer/Origin agar cookie sesi terbaca (tanpanya Sanctum 401)
# LOG_CHANNEL=stack
# LOG_STACK=single           <- 'stderr' bila log dikoleksi platform (Docker/Cloud)
# LOG_LEVEL=warning          <- production JANGAN debug: hemat disk & cegah bocor data sensitif ke log
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=***wajib-diisi***
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls        <- null | tls | ssl — wajib diset bila server SMTP mewajibkan enkripsi
# MAIL_USERNAME=***
# MAIL_PASSWORD=***wajib-diisi***
# ============ AKHIR BLOK PRODUKSI ============
# Produksi: set APP_ENV=production, APP_DEBUG=false
# Keamanan session produksi (aktifkan bila HTTPS):
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=strict
# SANCTUM_STATEFUL_DOMAINS=app.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Produksi: LOG_LEVEL=warning (JANGAN debug di prod — hemat disk & cegah data
# sensitif tertulis ke log). Lihat blok PRODUKSI di atas.
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Enkripsi isi sesi at-rest (default config true bila env tidak diset).
# Aman dibiarkan true di dev (transparan, tidak merusak http/LAN) — tidak
# seperti SESSION_SECURE_COOKIE yang WAJIB false bila masih HTTP (kalau true,
# browser tidak mengirim cookie via http://localhost/LAN dan login cookie-based gagal).
SESSION_ENCRYPT=true
# Produksi HTTPS: SESSION_ENCRYPT=true, SESSION_SECURE_COOKIE=true (lihat blok PRODUKSI).
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Produksi beban tinggi: QUEUE_CONNECTION=redis, CACHE_STORE=redis (lihat blok PRODUKSI).

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# null | tls | ssl — wajib diset saat MAIL_MAILER=smtp terhadap server SMTP yang
# mewajibkan enkripsi (mis. port 465/587). Produksi: MAIL_ENCRYPTION=tls.
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
