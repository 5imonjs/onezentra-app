# ===== Laravel (root) =====

# Dependencies
/vendor
/node_modules

# Environment & secrets — JANGAN PERNAH commit
/.env
/.env.*
!/.env.example

# Runtime storage (struktur folder dijaga lewat .gitkeep)
/storage/*.key
/storage/app/private/*
/storage/app/public/*
/storage/framework/cache/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
# Backup DB manual (mis. dump role_permission) — artefak lokal, jangan commit.
/storage/backups/
!/storage/**/.gitkeep
/public/storage

# Bootstrap cache
/bootstrap/cache/*.php

# Test & cache artifacts
/.phpunit.cache
.phpunit.result.cache
.phpactor.json

# SQLite database — jangan commit.
#
# Catatan: pola "/nama" (tanpa wildcard) hanya cocok untuk path PERSIS di root.
# File DB bisa muncul sebagai "onezentra_warehouse" (tanpa ekstensi) maupun
# "onezentra_warehouse.sqlite" — keduanya harus tertangkap, makanya ada
# versi wildcard.
/onezentra_warehouse
/onezentra_warehouse.*
/*.sqlite
/*.sqlite3
/*.db
/database/*.sqlite
/database/*.db

# ===== Frontend (onezentra-web) =====
onezentra-web/node_modules/
onezentra-web/.next/
onezentra-web/out/
onezentra-web/.env*
!onezentra-web/.env.example
onezentra-web/tsconfig.tsbuildinfo
onezentra-web/.turbo
onezentra-web/.vercel
onezentra-web/next-env.d.ts

# ===== Artefak sesi & cookie lokal =====
# cookies.txt (hasil `curl -c`) memuat laravel-session/sanctum token — JANGAN commit.
cookies.txt
**/cookies.txt

# ===== OS & editor =====
.DS_Store
**/.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
*.log
npm-debug.log*

# Next.js build output
.next/

# Playwright E2E — artefak hasil run (trace, screenshot, video).
# Hanya konfigurasi & spec yang di-commit, bukan hasil eksekusi.
onezentra-web/test-results/
onezentra-web/playwright-report/
onezentra-web/blob-report/
onezentra-web/.playwright/
/.freebuff

# Instruksi AI lokal — jangan commit (sengaja dihapus dari repo).
/AGENTS.md
/CLAUDE.md
/.mcp.json
onezentra-web/AGENTS.md
onezentra-web/CLAUDE.md
