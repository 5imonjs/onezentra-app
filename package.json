{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "web:dev": "cd onezentra-web && npm run dev",
        "web:build": "cd onezentra-web && npm run build",
        "web:start": "cd onezentra-web && npm start",
        "dev:all": "concurrently \"npm run dev\" \"npm run web:dev\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
