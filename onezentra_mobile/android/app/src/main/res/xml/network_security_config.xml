<?xml version="1.0" encoding="utf-8"?>
<!--
  Release/profile builds only allow HTTPS. The development variant overrides
  this file (android/app/src/debug/res/xml/network_security_config.xml) so the
  app can talk to a plain-HTTP Laravel server on a developer machine.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
